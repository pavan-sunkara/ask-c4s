{
  "manifest_version": 3,
  "name": "Ask C4S",
  "version": "0.27.86",
  "minimum_chrome_version": "114",
  "description": "Right-click any selection, use slash commands, or click the floating button on SAP C4C to ask C4S. Side panel + popup, markdown replies, one-click writeback, streaming, DOM scraping, Google SSO.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ask C4S — click for side panel, Ctrl+Shift+Y for popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?mode=sidepanel"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Ask C4S (side panel — v0.26.31+ default)"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open Ask C4S in the side panel"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.crm.ondemand.com/*",
        "https://*.crm.sap.com/*",
        "https://*.c4c.sap.com/*",
        "https://*.cloudfoundry.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "identity",
    "sidePanel",
    "clipboardWrite",
    "notifications",
    "alarms",
    "geolocation"
  ],
  "host_permissions": [
    "http://127.0.0.1:3031/*",
    "http://localhost:3031/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://*.crm.ondemand.com/*",
    "https://*.crm.sap.com/*",
    "https://*.c4c.sap.com/*",
    "https://*.cloudfoundry.io/*",
    "https://knowledge1.thermofisher.com/*",
    "https://*.thermofisher.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
