{
  "manifest_version": 3,
  "name": "Ask C4S",
  "version": "0.27.87",
  "minimum_chrome_version": "114",
  "description": "A companion for SAP Service Cloud (C4S): right-click a selection, use slash commands, or the on-page button to triage tickets, search the knowledge base, check parts, and draft replies.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ask C4S — click for side panel, Ctrl+Shift+Y for popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Ask C4S (side panel — v0.26.31+ default)"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open Ask C4S in the side panel"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.crm.ondemand.com/*",
        "https://*.crm.sap.com/*",
        "https://*.c4c.sap.com/*",
        "https://*.cloudfoundry.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "clipboardWrite",
    "notifications",
    "alarms",
    "geolocation"
  ],
  "host_permissions": [
    "http://127.0.0.1:3031/*",
    "http://localhost:3031/*",
    "https://ec2-54-83-232-127.compute-1.amazonaws.com/*",
    "https://*.crm.ondemand.com/*",
    "https://*.crm.sap.com/*",
    "https://*.c4c.sap.com/*",
    "https://*.cloudfoundry.io/*",
    "https://knowledge1.thermofisher.com/*",
    "https://*.thermofisher.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://*.tile.openstreetmap.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
