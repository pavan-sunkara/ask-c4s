# =============================================================================
# Ask C4S — backend secrets + AI provider keys
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Most of these can ALSO be configured via the admin page (/settings), which
# encrypts secrets at rest. Resolution order: Settings override → env var → default.

# --- SAP C4C connection ---
# Preferred: add the tenant in the admin page (/settings → Tenants). It is stored
# encrypted and always wins over these three, which are only a fallback.
C4C_BASE_URL=https://<tenant>.crm.ondemand.com/sap/c4c/odata/v1/c4codataapi
C4C_USER=
C4C_PASSWORD=

# --- HTTP port (the extension expects 3031 on localhost) ---
SERVICE_OPS_UI_PORT=3031

# --- Admin page (/settings) ---
ADMIN_ENABLED=true

# --- Shared admin password (legacy mode) ---
# Used only until the first personal account exists (see the next section).
# Pick anything long enough that it can't be brute-forced casually.
ASKC4S_INTERNAL_PASSWORD=change-me-to-something-strong

# --- Personal accounts (users + roles: owner / admin / manager / agent) ---
# Until the first account exists the deployment behaves exactly as before (the
# shared password above, SSO under ASKC4S_AUTH_ALLOWED_DOMAINS). Create the first
# owner in the admin page (Settings → Users) — or provision it from the
# environment on first boot, which suits hosted deployments:
# ASKC4S_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# ASKC4S_BOOTSTRAP_OWNER_PASSWORD=    # at least 12 characters; the owner must change it
#                                    # at first sign-in. Remove it after the first boot.
# Once accounts exist the shared password is refused (it has no identity and can't
# be revoked). Break-glass only:
# ASKC4S_ALLOW_SHARED_PASSWORD=true
# Locked out? On the host:  node dist/usersCli.js set-owner <email> <temporary-password>

# --- Azure AD / Entra ID (for the external KB and future C4C OAuth) ---
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=
# AZURE_AUTHORITY=https://login.microsoftonline.com

# --- Entra ID USER sign-in (OIDC) — the org SSO front door for the PWA/admin ---
# Distinct from the AZURE_* app above (that one is client-credentials for the KB
# and has no user redirect URIs). Same directory, so TENANT_ID defaults to
# AZURE_TENANT_ID if omitted. INERT until TENANT_ID + CLIENT_ID are set.
# App registration: platform "Web"; redirect URI = ENTRA_OIDC_REDIRECT_URI;
# single-tenant; Graph delegated openid/profile/email; a client secret.
# ENTRA_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_OIDC_CLIENT_SECRET=            # blank = pure PKCE public client
# ENTRA_OIDC_REDIRECT_URI=https://<shim-host>/api/auth/oidc/callback
# ENTRA_OIDC_ALLOWED_DOMAINS=          # comma-sep; empty = any verified tenant account

# --- External Knowledge Base (MindTouch) ---
# KB_API_BASE_URL=https://kb.example.com
# KB_API_SEARCH_PATH=/@api/deki/site/search
# KB_API_SCOPE=https://kb.example.com/.default

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Active provider for the /api/chat route
AI_PROVIDER=anthropic
