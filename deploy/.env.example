# Ask C4S on EC2 — copy to .env next to docker-compose.yml and fill in.
# Everything here is also handed to the server container (env_file).

# ---- Image (published by CI to GHCR) ----
# A private GHCR package needs `docker login ghcr.io` on the host first.
# <owner> is your GitHub username/org, lower-cased.
ASKC4S_IMAGE=ghcr.io/<owner>/ask-c4s:main

# ---- HTTPS (Caddy) ----
# SITE_ADDRESS is the hostname Caddy serves (and the extension's endpoint).
# TLS_MODE=internal         -> self-signed (Caddy's own CA); import the root CA on each client.
# TLS_MODE=you@example.com  -> Let's Encrypt (needs a real domain resolving here + 80/443 open).
SITE_ADDRESS=ec2-54-83-232-127.compute-1.amazonaws.com
TLS_MODE=internal

# ---- First boot only ----
# Creates the owner account; the owner must change this password at first
# sign-in. Remove both lines after the first start.
ASKC4S_BOOTSTRAP_OWNER_EMAIL=pavan.sunkara@thermofisher.com
ASKC4S_BOOTSTRAP_OWNER_PASSWORD=change-me-12-characters-minimum

# ---- Optional ----
# Pin the key that encrypts the SAP tenant passwords instead of the auto-generated
# /app/data/.tenant-key (64 hex characters: `openssl rand -hex 32`). Either way,
# back the key up together with the data volume.
# ADMIN_ENCRYPTION_KEY=

# Fallback SAP connection. The Tenants tab in the admin page is the normal way
# and always wins over these three.
# C4C_BASE_URL=https://<tenant>.crm.ondemand.com/sap/c4c/odata/v1/c4codataapi
# C4C_USER=
# C4C_PASSWORD=

# AI provider keys — can also be entered in the admin page, where they are
# stored encrypted.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Microsoft Entra ID sign-in for the field app and admin page (see docs/engineering-notes.md → Entra SSO).
# ENTRA_OIDC_TENANT_ID=
# ENTRA_OIDC_CLIENT_ID=
# ENTRA_OIDC_CLIENT_SECRET=
# ENTRA_OIDC_REDIRECT_URI=https://askc4s.example.com/api/auth/oidc/callback
